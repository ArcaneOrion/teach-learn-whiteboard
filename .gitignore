# ─────────────────────────────────────────────────────────────
#  .gitignore — 告诉 git「哪些文件不要进仓库」
#
#  规则：能重新生成的、体积大的、含密钥的，一律不进仓库。
# ─────────────────────────────────────────────────────────────

# ── 依赖（能重新装回来，不该进仓库）──
node_modules/
.pnpm-store/
.store/

# ── 构建产物（能重新编译出来）──
dist/
dist-ssr/
*.tsbuildinfo

# ── ★ 密钥与环境变量：绝对不能进仓库 ──
.env
.env.*
!.env.example
*.key
*.pem
*.p12

# ── ★ 安卓签名密钥：绝对不能进仓库（泄露 = 别人能冒名发布你的 App）──
*.jks
*.keystore
keystore.properties

# ── Capacitor 生成 / 同步产物 ──
# android/ 整体要入库（你可能会改 AndroidManifest），但这些子目录是生成的
android/app/src/main/assets/public/
android/app/src/main/assets/capacitor.config.json
android/app/src/main/assets/capacitor.plugins.json
android/app/src/main/res/xml/config.xml
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/capacitor-cordova-android-plugins/
android/app/src/main/assets/capacitorjs/

# ── 编辑器与系统文件 ──
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
.DS_Store
Thumbs.db
*.swp
*~

# ── 日志与缓存 ──
*.log
npm-debug.log*
pnpm-debug.log*
yarn-error.log*
.cache/
.vite/
coverage/

# ── ★ 同步服务的数据文件 ──
#     `pnpm sync-server` 默认就往仓库根目录写这个文件（里面是同步上去的全部内容）。
#     谁跑一次就会生成一个 —— 不挡的话下一个贡献者也会把它提交进来。
sync-data.json
sync-data*.json

# ── ★ 与这台机器绑定的工作笔记，不进公开仓库 ──
#     写的是本机怎么补 JDK / Android SDK、本机家目录路径这些，
#     对别人没用，公开出去只是噪音。文件留在本地，只是不跟踪。
docs/安卓构建环境.md

# ── Android 构建工具链（体积大、跟机器绑定、能重新装回来）──
#     JDK 由 nix 提供，不在这里；下面是自己下的 SDK 和 gradle 依赖缓存。
.android-sdk/
.gradle-home/
.home/

# ── 本地临时文件 ─
tmp/
temp/
*.tmp

# ── 验证用的截图等产物（可重新生成）──
.artifacts/

# ── pdfjs 的静态资源（cmaps / standard_fonts，2.5MB）
#    每次 pnpm install 都能重新生成：node scripts/sync-pdfjs-assets.mjs
public/pdfjs/
