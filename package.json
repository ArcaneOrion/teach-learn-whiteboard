{
  "name": "teach-learn-whiteboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "共写白板 —— 安卓本地学习白板",
  "scripts": {
    "predev": "node scripts/sync-pdfjs-assets.mjs",
    "dev": "vite",
    "prebuild": "node scripts/sync-pdfjs-assets.mjs",
    "build": "tsc --noEmit && vite build",
